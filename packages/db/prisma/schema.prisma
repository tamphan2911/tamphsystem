// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------
// 1. User & Identity Management
// ---------------------------------------------

enum Role {
  USER
  ADMIN
  MODERATOR
  LECTURER
  STUDENT
  RESEARCHER
  ASSISTANT
  CHIEF_ASSISTANT
}

enum ResearchAuthorNotificationType {
  CREATED
  PRODUCTION_FINISHED
  ACCEPTED
  PUBLISHED
}

enum ProposalType {
  RESEARCH
  PROJECT
  CONFERENCE
  JOURNAL
}

enum ProposalStatus {
  NEW
  REVIEWING
  ACCEPTED
  DECLINED
}

enum RegistrationStatus {
  NOT_REGISTERED
  PREPARING
  SUBMITTED
  APPROVED
}

enum JournalType {
  INTERNATIONAL
  LOCAL
}

enum JournalApprovalStatus {
  APPROVED
  PENDING_APPROVAL
}

enum PublisherAccountType {
  JOURNAL
  PUBLISHER
}

model User {
  id                            String    @id @default(uuid())
  email                         String    @unique
  additionalEmails              String[]  @default([])
  emailVerified                 DateTime?
  emailVerificationToken        String?   @unique
  emailVerificationTokenExpires DateTime?
  passwordResetToken            String?   @unique
  passwordResetTokenExpires     DateTime?
  name                          String?
  affiliation                   String    @default("Not set")
  passwordHash                  String
  adminVisiblePassword          String?
  avatarUrl                     String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  roles                         Role[] // A user can have multiple roles
  activeSites                   String[]  @default([])
  canManageResearchVenues       Boolean   @default(false)

  // Relations
  authoredCourses                 Course[]                     @relation("CourseAuthor")
  enrollments                     Enrollment[]
  sessionCompletions              SessionCompletion[]
  quizAttempts                    QuizAttempt[]
  researchProjects                ResearchProject[]            @relation("LeadResearcher")
  authoredResearch                ResearchProject[]            @relation("ResearchAuthors")
  researchAuthorEntries           ResearchProjectAuthor[]
  registeredResearch              ResearchProject[]            @relation("ResearchRegistrationUser")
  createdResearchTasks            ResearchTask[]               @relation("ResearchTaskCreator")
  checkedResearchTasks            ResearchTask[]               @relation("ResearchTaskChecker")
  completedResearchTasks          ResearchTask[]               @relation("ResearchTaskCompleter")
  redoRequestedResearchTasks      ResearchTask[]               @relation("ResearchTaskRedoRequester")
  revokedResearchTasks            ResearchTask[]               @relation("ResearchTaskRevoker")
  createdTaskGuides               TaskGuide[]                  @relation("TaskGuideCreator")
  createdSuggestedReviewers       SuggestedReviewer[]          @relation("SuggestedReviewerCreator")
  assignedResearchTasks           ResearchTaskAssignment[]     @relation("ResearchTaskAssignee")
  researchNotifications           ResearchNotification[]
  suggestedJournals               SuggestedJournal[]           @relation("SuggestedJournalCreator")
  suggestedConferences            SuggestedConference[]        @relation("SuggestedConferenceCreator")
  approvedSuggestedJournals       SuggestedJournal[]           @relation("SuggestedJournalApprover")
  approvedSuggestedConferences    SuggestedConference[]        @relation("SuggestedConferenceApprover")
  declinedSuggestedJournals       SuggestedJournal[]           @relation("SuggestedJournalDecliner")
  declinedSuggestedConferences    SuggestedConference[]        @relation("SuggestedConferenceDecliner")
  sentResearchAuthorNotifications ResearchAuthorNotification[] @relation("ResearchAuthorNotificationSender")
  createdOrganizedProjects        OrganizedProject[]           @relation("OrganizedProjectCreator")
  createdJournals                 Journal[]                    @relation("JournalCreator")
  organizedProjectMemberships     OrganizedProjectMember[]
  submittedProposals              Proposal[]                   @relation("ProposalSubmitter")
  requestedTaskClarifications     ResearchTaskClarification[]  @relation("TaskClarificationRequester")
  answeredTaskClarifications      ResearchTaskClarification[]  @relation("TaskClarificationAnswerer")
}

// ---------------------------------------------
// 2. Learning Management System (LMS)
// ---------------------------------------------

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   User   @relation("CourseAuthor", fields: [authorId], references: [id])

  modules     Module[]
  enrollments Enrollment[]
  completions SessionCompletion[]
}

model Module {
  id       String @id @default(uuid())
  title    String
  order    Int // Defines sequence within the course
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  sessions Session[]
  quizzes  Quiz[]
}

enum SessionType {
  LESSON_TEXT
  LESSON_VIDEO
  EXERCISE_QUIZ
  EXERCISE_ESSAY
  EXERCISE_CODING
}

model Session {
  id       String      @id @default(uuid())
  title    String
  type     SessionType
  order    Int // Defines sequence within the module
  year     Int?
  moduleId String
  module   Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  // Polymorphic Fields based on Type
  content        String? // Rich text for lessons or prompts for essays
  videoUrl       String? // For Video lessons
  codingLanguage String? // "python" or "r"
  initialCode    String? // Starter code for exercises
  expectedOutput String? // Expected string output for basic validation

  quiz        Quiz?
  completions SessionCompletion[]
}

model SessionCompletion {
  id          String   @id @default(uuid())
  userId      String
  sessionId   String
  courseId    String
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId, courseId])
}

model Enrollment {
  id                 String    @id @default(uuid())
  userId             String
  courseId           String
  progressPercentage Float     @default(0)
  enrolledAt         DateTime  @default(now())
  completedAt        DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ---------------------------------------------
// 3. Test Bank & Exercises
// ---------------------------------------------

enum QuestionType {
  MULTIPLE_CHOICE
  TEXT
}

model Quiz {
  id        String   @id @default(uuid())
  title     String
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sessionId String?  @unique
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id     String       @id @default(uuid())
  text   String
  type   QuestionType @default(MULTIPLE_CHOICE)
  quizId String
  quiz   Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers Answer[]
}

model Answer {
  id         String   @id @default(uuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  score       Float
  attemptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------
// 4. Research Management
// ---------------------------------------------

enum ResearchStage {
  PENDING
  PRODUCTION
  SUBMITTING
  REVIEW
  ACCEPTED
  PUBLISHED
}

enum ClaimStatus {
  CANNOT_CLAIM
  WAITING_PUBLISH
  MAKING_DOCUMENT
  WAITING
  CLAIMED
}

enum ConferenceType {
  INTERNATIONAL @map("International")
  NATIONAL      @map("National")
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  REVISION
  ACCEPTED
  REJECTED
  WITHDRAWN
  PUBLISHED
}

enum ConferenceSubmissionStatus {
  PLANNED
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  PUBLISHED
  WITHDRAWN
}

enum SuggestedVenueStatus {
  PENDING
  APPROVED
  DECLINED
}

enum CurrencyCode {
  VND
  USD
  CHF
  GBP
  EUR
}

enum ResearchTaskStatus {
  OPEN
  IN_PROGRESS
  REVISION_REQUESTED
  CHECKING
  NEED_CLARIFY
  COMPLETED
  REVOKED
}

enum ResearchTaskType {
  SUBMIT_RESEARCH
  SUBMIT_CONFERENCE
  PRODUCTION
  SUGGEST_VENUE
  ADD_JOURNAL
  REVIEW
  PROJECT_PRODUCTION
  PROJECT_RESEARCH_ASSOCIATED
  OTHER
}

enum ResearchTaskCategory {
  SUBMITTING          @map("Submitting")
  SUBMIT_RESEARCH     @map("Submit research")
  PRODUCTION          @map("Production")
  RESEARCH_PRODUCTION @map("Research production")
  REFERENCES          @map("References")
}

enum OrganizedProjectStatus {
  PENDING
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum OrganizedProjectFinancialClaimStatus {
  NONE
  NOT_ADVANCED
  ADVANCED
  SETTLED
  REFUND_ADVANCE
}

enum OrganizedProjectType {
  STUDENT
  FACULTY
  UNIVERSITY
  VNU
  NATIONAL
}

model ResearchProject {
  id              String        @id @default(uuid())
  researchCode    String?       @unique
  title           String
  abstract        String?
  sharedFolderUrl String?
  stage           ResearchStage @default(PRODUCTION)

  // Production Stage Tracking
  coAuthors                String?
  universityRegistration   String? // Registration period, e.g., "Q1 2026"
  registrationName         String?
  registrationUserId       String?
  registrationUser         User?               @relation("ResearchRegistrationUser", fields: [registrationUserId], references: [id], onDelete: SetNull)
  fundingInstitutionId     String?
  fundingInstitution       FundingInstitution? @relation(fields: [fundingInstitutionId], references: [id], onDelete: SetNull)
  registerStatus           RegistrationStatus  @default(NOT_REGISTERED)
  claimStatus              ClaimStatus         @default(CANNOT_CLAIM)
  completedProductionSteps String[]            @default([])
  productionTimelineLocked Boolean             @default(false)
  contentUnlocked          Boolean             @default(false)
  authorsUnlocked          Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadResearcherId String
  leadResearcher   User                    @relation("LeadResearcher", fields: [leadResearcherId], references: [id])
  authors          User[]                  @relation("ResearchAuthors")
  authorEntries    ResearchProjectAuthor[]

  publications          Publication[]
  submissions           ResearchSubmission[]
  conferenceSubmissions ConferenceSubmission[]
  suggestedJournals     SuggestedJournal[]
  suggestedConferences  SuggestedConference[]
  tasks                 ResearchTask[]
  authorNotifications   ResearchAuthorNotification[]
  organizedProjectLinks OrganizedProjectResearch[]
  sourceProposal        Proposal?                    @relation("ProposalCreatedResearch")

  @@index([registrationUserId])
  @@index([fundingInstitutionId])
}

model OrganizedProject {
  id                    String                               @id @default(uuid())
  title                 String
  organizer             String?
  referenceCode         String?
  description           String?
  sharedFolderUrl       String?
  projectType           OrganizedProjectType                 @default(STUDENT)
  status                OrganizedProjectStatus               @default(PLANNED)
  financialClaimStatus  OrganizedProjectFinancialClaimStatus @default(NONE)
  requiredResearchCount Int?
  requiredProducts      String[]                             @default([])
  completedProducts     String[]                             @default([])
  fundingAmount         Decimal?
  fundingCurrency       CurrencyCode                         @default(VND)
  startDate             DateTime?
  durationMonths        Int?
  endDate               DateTime?
  note                  String?
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt

  createdById String?
  createdBy   User?   @relation("OrganizedProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  fundingInstitutionId String?
  fundingInstitution   FundingInstitution? @relation(fields: [fundingInstitutionId], references: [id], onDelete: SetNull)

  members        OrganizedProjectMember[]
  research       OrganizedProjectResearch[]
  tasks          ResearchTask[]
  sourceProposal Proposal?                  @relation("ProposalCreatedProject")

  @@index([status])
  @@index([projectType])
  @@index([organizer])
  @@index([financialClaimStatus])
  @@index([fundingInstitutionId])
}

model FundingInstitution {
  id         String   @id @default(uuid())
  funderCode String?  @unique
  name       String
  shortName  String?
  country    String?
  website    String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organizedProjects OrganizedProject[]
  researchProjects  ResearchProject[]

  @@index([name])
}

model OrganizedProjectMember {
  id                 String   @id @default(uuid())
  organizedProjectId String
  userId             String
  position           Int
  selectedEmail      String?
  isTeamLead         Boolean  @default(false)
  isInstructor       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organizedProject OrganizedProject @relation(fields: [organizedProjectId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizedProjectId, userId])
  @@index([organizedProjectId, position])
  @@index([userId])
}

model OrganizedProjectResearch {
  id                 String   @id @default(uuid())
  organizedProjectId String
  researchProjectId  String
  resultNote         String?
  createdAt          DateTime @default(now())

  organizedProject OrganizedProject @relation(fields: [organizedProjectId], references: [id], onDelete: Cascade)
  researchProject  ResearchProject  @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)

  @@unique([organizedProjectId, researchProjectId])
  @@index([researchProjectId])
}

model ResearchAuthorNotification {
  id        String                         @id @default(uuid())
  projectId String
  type      ResearchAuthorNotificationType
  sentAt    DateTime                       @default(now())
  sentById  String?
  results   Json

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sentBy  User?           @relation("ResearchAuthorNotificationSender", fields: [sentById], references: [id], onDelete: SetNull)

  @@unique([projectId, type])
  @@index([projectId])
}

model ResearchNotification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  title      String
  summary    String
  body       String?
  href       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([entityType, entityId])
}

model ResearchProjectAuthor {
  id              String   @id @default(uuid())
  projectId       String
  userId          String
  position        Int
  selectedEmail   String?
  isCorresponding Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, position])
}

model Proposal {
  id                        String         @id @default(uuid())
  type                      ProposalType
  status                    ProposalStatus @default(NEW)
  title                     String
  description               String
  contactInfo               String?
  notes                     String?
  identifier                String?
  organization              String?
  location                  String?
  website                   String?
  venueType                 String?
  decisionComment           String?
  decidedAt                 DateTime?
  decidedById               String?
  supportFileName           String?
  supportFileType           String?
  supportFileSize           Int?
  supportFileData           Bytes?
  submittedById             String
  createdResearchProjectId  String?        @unique
  createdOrganizedProjectId String?        @unique
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  submittedBy             User              @relation("ProposalSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  createdResearchProject  ResearchProject?  @relation("ProposalCreatedResearch", fields: [createdResearchProjectId], references: [id], onDelete: SetNull)
  createdOrganizedProject OrganizedProject? @relation("ProposalCreatedProject", fields: [createdOrganizedProjectId], references: [id], onDelete: SetNull)

  @@index([type, status, createdAt])
  @@index([submittedById, createdAt])
}

model Conference {
  id                     String          @id @default(uuid())
  name                   String
  type                   ConferenceType?
  themes                 String?
  targetTheme            String?
  isbn                   String?         @unique
  organizer              String?
  location               String?
  startDate              DateTime?
  endDate                DateTime?
  submissionDeadline     DateTime?
  acceptanceNotification DateTime?
  closeDate              DateTime?
  editUnlocked           Boolean         @default(false)
  apc                    String?
  apcCurrency            CurrencyCode    @default(USD)
  submissionFee          String?
  submissionFeeCurrency  CurrencyCode    @default(USD)
  website                String?
  note                   String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  submissions ConferenceSubmission[]
  suggestions SuggestedConference[]
  tasks       ResearchTask[]
}

model SuggestedConference {
  id               String               @id @default(uuid())
  projectId        String
  taskId           String?
  submissionTaskId String?              @unique
  conferenceId     String?
  venueName        String?
  venueLink        String?
  note             String?
  status           SuggestedVenueStatus @default(APPROVED)
  approvedAt       DateTime?
  approvedById     String?
  declinedAt       DateTime?
  declinedById     String?
  declineReason    String?
  requiresApproval Boolean              @default(false)
  createdById      String?
  createdAt        DateTime             @default(now())

  project        ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           ResearchTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  submissionTask ResearchTask?   @relation("SuggestedConferenceSubmissionTask", fields: [submissionTaskId], references: [id], onDelete: SetNull)
  conference     Conference?     @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("SuggestedConferenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?           @relation("SuggestedConferenceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  declinedBy     User?           @relation("SuggestedConferenceDecliner", fields: [declinedById], references: [id], onDelete: SetNull)

  @@unique([projectId, conferenceId])
  @@index([projectId, status])
  @@index([taskId])
  @@index([submissionTaskId])
  @@index([approvedById])
  @@index([declinedById])
}

model ConferenceSubmission {
  id                String                     @id @default(uuid())
  submissionCode    String?                    @unique
  conferenceId      String
  researchProjectId String
  status            ConferenceSubmissionStatus @default(PLANNED)
  submittedAt       DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  withdrawnAt       DateTime?
  publishedAt       DateTime?
  note              String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  conference Conference      @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  project    ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, researchProjectId])
}

model Journal {
  id                    String                @id @default(uuid())
  name                  String
  issn                  String?
  field                 String?
  fields                String[]              @default([])
  type                  JournalType           @default(INTERNATIONAL)
  rank                  String? // Q1, Q2, Q3, Q4
  localRank             String?
  issuesPerYear         Int?
  isFavorite            Boolean               @default(false)
  isInterest            Boolean               @default(false)
  publisher             String?
  publisherId           String?
  country               String?
  apc                   String?
  apcCurrency           CurrencyCode          @default(USD)
  hasApcOption          Boolean               @default(false)
  submissionFee         String?
  submissionFeeCurrency CurrencyCode          @default(USD)
  homepageLink          String?
  submissionLink        String?
  scimagoLink           String?
  scopusLink            String?
  note                  String?
  approvalStatus        JournalApprovalStatus @default(APPROVED)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt

  createdById     String?
  resultTaskId    String?
  resultPosition  Int?
  createdBy       User?         @relation("JournalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  resultTask      ResearchTask? @relation("ResearchTaskAddedJournals", fields: [resultTaskId], references: [id], onDelete: SetNull)
  publisherRecord Publisher?    @relation(fields: [publisherId], references: [id], onDelete: SetNull)

  submissions ResearchSubmission[]
  accounts    PublisherAccount[]
  reviews     AcademicReview[]
  suggestions SuggestedJournal[]
  tasks       ResearchTask[]

  @@unique([resultTaskId, resultPosition])
  @@index([createdById])
  @@index([publisherId])
  @@index([approvalStatus])
  @@index([resultTaskId])
}

model Publisher {
  id                String   @id @default(uuid())
  publisherCode     String   @unique
  name              String
  normalizedName    String   @unique
  alias             String?
  country           String?
  website           String?
  note              String?
  usesSingleAccount Boolean  @default(false)
  approvalStatus    JournalApprovalStatus @default(APPROVED)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  journals Journal[]
  accounts PublisherAccount[]

  @@index([approvalStatus])
}

model SuggestedJournal {
  id                    String               @id @default(uuid())
  projectId             String
  taskId                String?
  journalCreationTaskId String?              @unique
  submissionTaskId      String?              @unique
  journalId             String?
  venueName             String?
  venueLink             String?
  note                  String?
  status                SuggestedVenueStatus @default(APPROVED)
  approvedAt            DateTime?
  approvedById          String?
  declinedAt            DateTime?
  declinedById          String?
  declineReason         String?
  requiresApproval      Boolean              @default(false)
  createdById           String?
  createdAt             DateTime             @default(now())

  project             ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                ResearchTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  journalCreationTask ResearchTask?   @relation("SuggestedJournalCreationTask", fields: [journalCreationTaskId], references: [id], onDelete: SetNull)
  submissionTask      ResearchTask?   @relation("SuggestedJournalSubmissionTask", fields: [submissionTaskId], references: [id], onDelete: SetNull)
  journal             Journal?        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  createdBy           User?           @relation("SuggestedJournalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy          User?           @relation("SuggestedJournalApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  declinedBy          User?           @relation("SuggestedJournalDecliner", fields: [declinedById], references: [id], onDelete: SetNull)

  @@unique([projectId, journalId])
  @@index([projectId, status])
  @@index([taskId])
  @@index([journalCreationTaskId])
  @@index([submissionTaskId])
  @@index([approvedById])
  @@index([declinedById])
}

model AcademicReview {
  id              String    @id @default(uuid())
  journalId       String
  accountId       String?
  manuscriptTitle String
  manuscriptId    String?
  status          String    @default("INVITED") // INVITED, ACCEPTED, IN_PROGRESS, SUBMITTED, DECLINED
  recommendation  String?
  requestedAt     DateTime  @default(now())
  dueDate         DateTime?
  completedAt     DateTime?
  editorName      String?
  reviewRound     String?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  journal Journal           @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account PublisherAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  tasks   ResearchTask[]

  @@index([accountId])
}

model ResearchTask {
  id                        String                @id @default(uuid())
  taskCode                  String?               @unique
  title                     String
  description               String?
  category                  ResearchTaskCategory?
  status                    ResearchTaskStatus    @default(IN_PROGRESS)
  dueDate                   DateTime?
  completedAt               DateTime?
  completedById             String?
  completionMessage         String?
  redoRequestedAt           DateTime?
  redoRequestedById         String?
  redoReason                String?
  revokedAt                 DateTime?
  revokedById               String?
  revokeReason              String?
  adminViewedAt             DateTime?
  taskFileName              String?
  taskFileType              String?
  taskFileSize              Int?
  taskFileData              Bytes?
  allowAssigneeReportUpload Boolean               @default(false)
  journalTargetCount        Int?
  reportFileName            String?
  reportFileType            String?
  reportFileSize            Int?
  reportFileData            Bytes?
  reportUploadedAt          DateTime?
  reportUploadedById        String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  createdById        String
  checkerId          String?
  createdBy          User              @relation("ResearchTaskCreator", fields: [createdById], references: [id])
  checker            User?             @relation("ResearchTaskChecker", fields: [checkerId], references: [id], onDelete: SetNull)
  completedBy        User?             @relation("ResearchTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  redoRequestedBy    User?             @relation("ResearchTaskRedoRequester", fields: [redoRequestedById], references: [id], onDelete: SetNull)
  revokedBy          User?             @relation("ResearchTaskRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  projectId          String?
  organizedProjectId String?
  journalId          String?
  conferenceId       String?
  reviewId           String?
  accountId          String?
  taskType           ResearchTaskType?
  project            ResearchProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  organizedProject   OrganizedProject? @relation(fields: [organizedProjectId], references: [id], onDelete: SetNull)
  journal            Journal?          @relation(fields: [journalId], references: [id], onDelete: SetNull)
  conference         Conference?       @relation(fields: [conferenceId], references: [id], onDelete: SetNull)
  review             AcademicReview?   @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  account            PublisherAccount? @relation("ResearchTaskAccount", fields: [accountId], references: [id], onDelete: SetNull)

  assignments                    ResearchTaskAssignment[]
  clarifications                 ResearchTaskClarification[]
  guides                         TaskGuide[]                 @relation("ResearchTaskGuides")
  suggestedReviewers             SuggestedReviewer[]         @relation("ResearchTaskSuggestedReviewers")
  suggestedJournals              SuggestedJournal[]
  suggestedConferences           SuggestedConference[]
  addedJournals                  Journal[]                   @relation("ResearchTaskAddedJournals")
  journalCreationSuggestion      SuggestedJournal?           @relation("SuggestedJournalCreationTask")
  journalSubmissionSuggestion    SuggestedJournal?           @relation("SuggestedJournalSubmissionTask")
  conferenceSubmissionSuggestion SuggestedConference?        @relation("SuggestedConferenceSubmissionTask")

  @@index([checkerId])
  @@index([completedById])
  @@index([redoRequestedById])
  @@index([revokedById])
}

model SuggestedReviewer {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  institution String?
  bio         String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?          @relation("SuggestedReviewerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     ResearchTask[] @relation("ResearchTaskSuggestedReviewers")

  @@index([name])
  @@index([institution])
  @@index([updatedAt])
}

model TaskGuide {
  id          String   @id @default(uuid())
  guideCode   String   @unique
  title       String
  content     String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?          @relation("TaskGuideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     ResearchTask[] @relation("ResearchTaskGuides")

  @@index([createdById])
  @@index([updatedAt])
}

model ResearchTaskAssignment {
  id         String    @id @default(uuid())
  taskId     String
  userId     String
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  task ResearchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User         @relation("ResearchTaskAssignee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model ResearchTaskClarification {
  id            String    @id @default(uuid())
  taskId        String
  requestedById String
  answeredById  String?
  question      String
  answer        String?
  answeredAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  task        ResearchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User         @relation("TaskClarificationRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  answeredBy  User?        @relation("TaskClarificationAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model PublisherAccount {
  id          String               @id @default(uuid())
  username    String
  password    String // Stored in plain/reversible text for personal tracking
  email       String?
  note        String?
  accountType PublisherAccountType @default(JOURNAL)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  journalId   String?
  journal     Journal?             @relation(fields: [journalId], references: [id], onDelete: SetNull)
  publisherId String?
  publisher   Publisher?           @relation(fields: [publisherId], references: [id], onDelete: SetNull)

  submissions ResearchSubmission[]
  reviews     AcademicReview[]
  tasks       ResearchTask[]       @relation("ResearchTaskAccount")

  @@index([journalId])
  @@index([publisherId])
  @@index([accountType])
}

model ResearchSubmission {
  id                String  @id @default(uuid())
  submissionCode    String? @unique
  researchProjectId String
  journalId         String
  accountId         String? // Which account was used to submit

  submittedAt     DateTime         @default(now())
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  withdrawnAt     DateTime?
  publishedAt     DateTime?
  articleUrl      String?
  articleFileName String?
  articleFileType String?
  articleFileSize Int?
  articleFileData Bytes?
  status          SubmissionStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  project ResearchProject   @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  journal Journal           @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account PublisherAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([researchProjectId, journalId])
}

model Publication {
  id            String          @id @default(uuid())
  title         String
  url           String?
  scimagoLink   String?
  scopusLink    String?
  rank          String?
  publishedDate DateTime
  projectId     String
  project       ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
